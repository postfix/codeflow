{
  "name": "coding-flow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/src/sdk.js",
    "./host": "./dist/src/host.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist --rootDir .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run build --silent && vitest --exclude 'dist/**'",
    "test:foundation": "npm run build --silent && node dist/tests/qualification.test.js"
  },
  "dependencies": {
    "esbuild": "0.25.9",
    "fs-ext": "2.1.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/fs-ext": "2.0.3",
    "@types/node": "24.3.0",
    "typescript": "^5.9.2",
    "vitest": "4.0.17"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "allowScripts": {
    "esbuild@0.25.9": true,
    "esbuild@0.28.2": true,
    "fs-ext@2.1.1": true
  }
}
